# BrahmnMitra Backend — Environment Variables Template
# Copy these key-value pairs into your Render dashboard (Environment Variables section)
# or local .env file. Never commit real credentials to Git.

# --- Mail Server (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=enquiry@brahmnmitra.com
SMTP_PASSWORD=your_app_password_here
SMTP_DEBUG=0

# --- Email Notifications ---
TO_EMAIL=info@brahmnmitra.com
FROM_EMAIL=enquiry@brahmnmitra.com
FROM_NAME="BrahmnMitra Website"

# --- Business Details ---
BIZ_NAME="BrahmnMitra"
BIZ_PHONE="+91 92117 61885"
BIZ_WA="919211761885"
BIZ_EMAIL="info@brahmnmitra.com"
BIZ_CITY="New Delhi, India"

# --- Security & CORS ---
# Set to your frontend domains (comma-separated, e.g. https://brahmnmitra.com,https://admin.brahmnmitra.com)
# or set to '*' to allow all origins.
ALLOWED_ORIGIN=https://brahmnmitra.com,https://admin.brahmnmitra.com
RATE_LIMIT_PER_HOUR=12
TIMEZONE=Asia/Kolkata
