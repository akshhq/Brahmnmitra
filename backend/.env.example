# ==========================================
# BrahmnMitra Backend — Environment Variables Template
# Copy this file to .env and configure your production credentials.
# ==========================================

# --- Database Configuration (Hostinger / MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u844555645_brahmnmitra
DB_USER=u844555645_brahmnmitra
DB_PASS=your_database_password_here
DB_CHARSET=utf8mb4

# --- Authentication & Security ---
AUTH_SECRET=your_random_64_char_secret_key_here
AUTH_TOKEN_TTL_HOURS=72
ALLOWED_ORIGIN=https://brahmnmitra.com,https://admin.brahmnmitra.com

# --- Mail Server (SMTP) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=info@brahmnmitra.com
SMTP_PASSWORD=your_email_password_here
SMTP_DEBUG=0

# --- Email Notifications ---
TO_EMAIL=info@brahmnmitra.com
FROM_EMAIL=enquiry@brahmnmitra.com
FROM_NAME="BrahmnMitra Desk"

# --- Business Details ---
BIZ_NAME="BrahmnMitra"
BIZ_PHONE="+91 92117 61885"
BIZ_WA="919211761885"
BIZ_EMAIL="info@brahmnmitra.com"
BIZ_CITY="New Delhi, India"

RATE_LIMIT_PER_HOUR=30
TIMEZONE=Asia/Kolkata
