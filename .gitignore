# ==========================================
# BrahmnMitra Project .gitignore
# ==========================================

# --- Environment & Credentials ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.p12
*.crt
credentials.json

# --- Dependencies ---
node_modules/
vendor/
.pnp
.pnp.js

# --- Package Manager Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Runtime & Server Logs ---
logs/
*.log
*.log.*
access_log
error_log
php_error.log

# --- Database & Backups ---
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.dump

# --- Python Cache & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- IDE & Editor Files ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
[Nn]on[Rr]oaming/
[Tt]emp/
*.tmp

# --- Build & Output Artifacts ---
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
